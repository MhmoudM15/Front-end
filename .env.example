# Public base domain used to split "{slug}.{domain}" hostnames.
# Keep it identical to PLATFORM_BASE_DOMAIN in backend/.env.
VITE_PLATFORM_BASE_DOMAIN=edunova.com

# Read-only local fixtures; no Django server is required.
# Set false when running the real Django API on 127.0.0.1:8000.
VITE_DEMO_MODE=true
